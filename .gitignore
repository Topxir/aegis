# Секреты (НИКОГДА не коммитить)
*.key
*.pem
*.p12
*.jks
*.keystore
.env
.env.*
secrets/
*.secret

# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# Android / Kotlin
.gradle/
build/
local.properties
*.apk
*.aab
captures/
.cxx/

# Node (desktop/web, если появятся)
node_modules/
dist/

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Данные и логи
*.db
*.sqlite
*.log

# Релизные сборки в папке builds/ (APK для Android и ПК-клиент)
!builds/
!builds/**
# APK больше 100 МБ (IPtProxy): прикладывается к GitHub Release, в git не хранится
builds/android-apk/*.apk
!builds/desktop/*.exe
!builds/desktop/*.dll

# The relay server is kept out of the repository
crates/aegis-server/
builds/server/
scripts/build.local.ps1
target-ui/
*.WebView2/

# Signing material
*.jks
*.keystore
keystore.properties
